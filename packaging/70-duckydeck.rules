# DuckyDeck: give the logged-in user access to the Elgato Stream Deck + (no root needed).
KERNEL=="hidraw*", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="0084", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="0084", TAG+="uaccess"
# Plugging the deck in also starts the user daemon (e.g. right after package installation).
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTRS{idVendor}=="0fd9", ATTRS{idProduct}=="0084", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="duckydeck.service"
