#!/usr/bin/env python3
# Example persistent dial script: one process gets every event and answers
# whenever it likes. Bind `script.knob` to a dial.
# duckydeck-label: Knob
# duckydeck-slot: dial
# duckydeck-persistent: true
import json
import sys

value = 50
for line in sys.stdin:
    event = json.loads(line)
    if event["event"] == "twist":
        value = max(0, min(100, value + 5 * event["delta"]))
    elif event["event"] == "press":
        value = 0
    print(json.dumps({"label": f"Knob {value}%", "value": value}), flush=True)
